# Pibazaar Environment Variables

# Pi Network
PI_API_KEY=your_pi_api_key_here
PI_WALLET_ADDRESS=your_wallet_address

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/pibazaar
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRY=7d

# File Storage
S3_BUCKET=pibazaar-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key

# Node Environment
NODE_ENV=development
PORT=3000

# Frontend
VITE_API_URL=http://localhost:3000
VITE_PI_API_KEY=your_pi_api_key_here

# Logging
LOG_LEVEL=debug

# Notifications
NOTIFICATION_SERVICE_URL=http://localhost:3001

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Rate Limiting
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX_REQUESTS=100

# Stripe/Payment (if needed later)
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_PUBLIC_KEY=pk_test_xxxxx
